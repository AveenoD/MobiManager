# Base URL of the main MobiManager Next app (no trailing slash).
# Landing page fetches /api/public/plans from here (server-side) so pricing matches the DB.
MOBIMGR_WEB_ORIGIN=http://localhost:3000

# "true" = sign-in / register POST to the main app; cookies + redirect on the main origin.
# Requires ALLOWED_ORIGINS on the main app to include this site's origin (e.g. http://localhost:5173).
MOBIMGR_INTEGRATE_BACKEND=true

# Optional: public canonical URL for SEO <link rel="canonical"> (defaults to https://mobimgr.com)
# SITE_PUBLIC_URL=https://mobimgr.com
